# Copy to .env and fill in. .env is gitignored; this example file is not.

EXTERNAL_HOST=127.0.0.1
EXTERNAL_PORT=8100
# THE switch that selects where messages come from. Comma list of gmail, slack,
# fixture -- and nothing else; an unrecognized name stops the service starting
# rather than being skipped, because a typo here is otherwise indistinguishable
# from a quiet inbox.
#
#   fixture  development and tests. Serves the committed Bob/Alice example
#            messages. Needs no credentials.
#   slack    real Slack messages. Requires SLACK_BOT_TOKEN and SLACK_APP_TOKEN
#            below; without them the service refuses to start and says which
#            one is missing. It does NOT fall back to fixture.
#
# Listing both serves the examples alongside real traffic, which is a useful
# rehearsal trick and a confusing demo. The startup log warns when you do.
EXTERNAL_ADAPTERS=fixture
EXTERNAL_BUFFER_SIZE=500
EXTERNAL_MAX_CONTENT_CHARS=2000
# local | utc -- controls the offset on emitted timestamps.
EXTERNAL_TZ=local
# true exposes POST /debug/inject.
EXTERNAL_DEBUG=false

GMAIL_ENABLED=false
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
# Personal @gmail.com and Google Workspace differ only in this line.
GMAIL_ADDRESS=
# 16 characters. Google displays it as 4 groups of 4; spaces are stripped for you.
# Requires 2-Step Verification to be ON, otherwise the app-password page is
# unavailable and you need the OAuth path instead.
GMAIL_APP_PASSWORD=
GMAIL_MAILBOX=INBOX
GMAIL_POLL_SECONDS=30
GMAIL_SINCE_DAYS=1
GMAIL_MAX_FETCH=25
# true = only unread mail. false = everything from the last GMAIL_SINCE_DAYS days,
# which survives you opening the message in Gmail (handy during a demo).
GMAIL_ONLY_UNSEEN=true
# true delivers only mail that ARRIVES after this process starts, matching Slack
# (Socket Mode delivers nothing from before it connected). false takes everything
# from the last GMAIL_SINCE_DAYS days, which fills the dashboard immediately but
# shows mail from before the session began.
GMAIL_ONLY_SINCE_STARTUP=true

# Not read by anything. EXTERNAL_ADAPTERS above is what selects Slack; this
# flag is kept only so that setting it and nothing else produces a warning at
# startup instead of a service quietly serving fixture messages.
SLACK_ENABLED=false
# Both are required by EXTERNAL_ADAPTERS=slack. The bare prefixes below count as
# unset -- a copied example configures nothing, and saying so at startup beats
# an invalid_auth from Slack that names no variable.
# Bot User OAuth Token, Install App page. Scopes: channels:history,
# channels:read, users:read.
SLACK_BOT_TOKEN=xoxb-
# App-Level Token, Basic Information page. Scope: connections:write.
SLACK_APP_TOKEN=xapp-
# Empty means every public channel the bot has been invited to.
SLACK_CHANNEL_ALLOWLIST=
# Socket Mode has no backfill: events sent while this process is down are
# gone. On connect, replay this many minutes of channel history to soften
# that. 0 disables it. Useful before a demo, when the messages you want to
# show were posted before you started the service.
SLACK_BACKFILL_MINUTES=0

# ---------------------------------------------------------------------------
# Sending. Read this section before changing anything in it.
# ---------------------------------------------------------------------------
# true validates, routes and records every send but hands nothing to Gmail or
# Slack. The whole integration works against it. Set it false only when you
# actually want mail to leave this machine, and set the allowlist first.
EXTERNAL_SEND_DRY_RUN=true
# Comma list of email addresses and Slack channel IDs a REAL send may target.
# Empty means anywhere, which is the right setting for nobody once an AI is
# choosing the words. Put your own address and the demo channel here.
EXTERNAL_SEND_ALLOWLIST=
EXTERNAL_OUTBOX_SIZE=500
EXTERNAL_REPLY_REGISTRY_SIZE=2000

# Outgoing mail reuses GMAIL_ADDRESS and GMAIL_APP_PASSWORD above; an app
# password works for SMTP as well as IMAP, so there is nothing new to set up.
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
# Display name on outgoing mail. Empty uses the bare address.
GMAIL_FROM_NAME=
# SMTP does not populate Gmail's Sent folder -- a reply would be delivered but
# invisible in your own account, which looks exactly like a failure during a
# demo. true files a copy over IMAP so the reply appears in the thread.
GMAIL_APPEND_TO_SENT=true
# Empty auto-detects the Sent folder from its special-use flag, which is the
# only reliable way: the name is localized per account language.
GMAIL_SENT_MAILBOX=

# Where POST /send/slack posts when the caller names no channel.
SLACK_DEFAULT_CHANNEL=

# ---------------------------------------------------------------------------
# Google Calendar
# ---------------------------------------------------------------------------
# memory | google. "memory" needs no credentials and keeps events for the life
# of the process -- enough to demo the whole flow. "google" needs the one-off
# OAuth setup in docs/Setup.md; without a token it falls back to memory and
# says so in GET /health rather than failing to start.
CALENDAR_BACKEND=memory
CALENDAR_ID=primary
# Empty defaults to src/external/credentials.json and src/external/token.json.
GOOGLE_CREDENTIALS_FILE=
GOOGLE_TOKEN_FILE=
# true lets Google email the attendees when an event is created. Off for the
# same reason sending is off: it leaves the machine.
CALENDAR_SEND_INVITES=false
